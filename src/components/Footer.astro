---
import type { HTMLAttributes } from "astro/types";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center border-t py-6 text-center"
  >
    <p class="text-muted-foreground mt-2 text-xs">
      &copy; {currentYear} Cory Wong. All rights reserved.
    </p>
  </div>
</footer>
