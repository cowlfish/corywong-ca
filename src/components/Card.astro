---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import dayjs from "dayjs";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, pubDatetime } = data;
const formattedDate = dayjs(pubDatetime).format("MMMM D, YYYY");
---

<li class="border-border border-b py-6 last:border-b-0">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "text-foreground inline-block text-lg font-medium",
      "underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
    style="font-family: var(--font-app); letter-spacing: -0.01em;"
  >
    <Heading transition:name={toTransitionName(title)}>
      {title}
    </Heading>
  </a>
  <p class="text-muted-foreground mt-1 text-xs font-medium uppercase tracking-widest">
    {formattedDate}
  </p>
  <p class="text-foreground/80 mt-2 text-sm leading-relaxed">{description}</p>
</li>
