---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-3xl font-semibold sm:my-8 sm:text-4xl" style="letter-spacing: -0.02em;">
        Cory Wong
      </h1>
      <p class="text-muted-foreground">
        Writing about fitness, technology, and things worth paying attention to.
      </p>
    </section>

    <section id="posts" class="pt-8 pb-6">
      <ul>
        {sortedPosts.map(data => (
          <Card variant="h3" {...data} />
        ))}
      </ul>
    </section>

    <section id="newsletter" class="border-border border-t pt-8 pb-12">
      <h2 class="mb-2 text-lg font-semibold">Get the Newsletter</h2>
      <p class="text-muted-foreground mb-4 text-sm">Fitness, tech, and other things. No schedule, no filler.</p>
      <form class="flex flex-col gap-3 sm:flex-row sm:items-start" action="#" method="post">
        <input
          type="text"
          name="first_name"
          placeholder="First name"
          required
          aria-label="First name"
          class="border-border bg-background text-foreground placeholder:text-muted-foreground flex-1 rounded border px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-foreground"
        />
        <input
          type="email"
          name="email"
          placeholder="Email"
          required
          aria-label="Email address"
          class="border-border bg-background text-foreground placeholder:text-muted-foreground flex-1 rounded border px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-foreground"
        />
        <button
          type="submit"
          class="bg-foreground text-background rounded px-4 py-2 text-sm font-medium hover:opacity-80"
        >
          Subscribe
        </button>
      </form>
      <p class="text-muted-foreground mt-2 text-xs">By subscribing, you agree to receive emails from Cory Wong. Unsubscribe anytime.</p>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
