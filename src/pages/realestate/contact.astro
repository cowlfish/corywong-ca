---
import Layout from '../../layouts/RealestateLayout.astro';
---

<Layout
  title="Contact Cory Wong | Real Estate Agent | Trustwell Realty Inc., Brokerage"
  description="Book a free consultation with Cory Wong, Real Estate Agent, Trustwell Realty Inc., Brokerage. Serving Toronto, Markham, Richmond Hill, and the broader GTA."
  canonicalPath="/contact"
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Let's Connect</h1>
      <p class="page-hero__subtitle">
        Whether you're buying, selling, or just getting started, I'm happy to talk through
        your situation. No commitment required.
      </p>
    </div>
  </section>

  <!-- Calendly Section -->
  <section class="calendly-section">
    <div class="container content-narrow">
      <h2 class="section-heading">Book a Consultation</h2>
      <p class="calendly-section__subtitle">
        A 30-minute consultation is free. Pick a time below.
      </p>
      <div class="calendly-container">
        <div
          class="calendly-inline-widget"
          data-url="https://calendly.com/trustwell-corywong/general"
          style="min-width: 320px; height: 700px;"
        ></div>
        <noscript>
          <p class="calendly-fallback">
            JavaScript is required to load the scheduling widget. Please
            <a href="https://calendly.com/trustwell-corywong/general" target="_blank" rel="noopener noreferrer">
              visit Calendly directly
            </a>
            to book a consultation.
          </p>
        </noscript>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="contact-form-section" id="contact-form">
    <div class="container content-narrow">
      <h2 class="section-heading">Prefer to Reach Out by Form?</h2>
      <form id="contact-form-el" class="lead-form" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label for="contact-name">Name</label>
            <input type="text" id="contact-name" name="name" required autocomplete="name" />
          </div>
          <div class="form-group">
            <label for="contact-email">Email</label>
            <input type="email" id="contact-email" name="email" required autocomplete="email" />
          </div>
        </div>
        <div class="form-group">
          <label for="contact-phone">Phone <span class="label-optional">(optional)</span></label>
          <input type="tel" id="contact-phone" name="phone" autocomplete="tel" />
        </div>
        <div class="form-group">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="5" required placeholder="What can I help you with?"></textarea>
        </div>
        <button type="submit" class="cta cta--primary form-submit">Send Message</button>
        <p id="contact-form-status" class="form-status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <!-- Newsletter Signup -->
  <section class="newsletter">
    <div class="container content-narrow">
      <h2 class="newsletter__heading">Stay Informed</h2>
      <p class="newsletter__text">
        Get monthly market data, neighbourhood insights, and practical advice for buyers
        and sellers across the Greater Toronto Area.
      </p>
      <form id="newsletter-form" class="newsletter__form" novalidate>
        <input
          type="email"
          id="newsletter-email"
          name="email"
          placeholder="you@example.com"
          required
          autocomplete="email"
          class="newsletter__input"
        />
        <button type="submit" class="cta cta--primary newsletter__btn">Subscribe</button>
      </form>
      <p id="newsletter-form-status" class="form-status" aria-live="polite"></p>
    </div>
  </section>
</Layout>

<script>
  // Load Calendly widget script
  const calendlyScript = document.createElement('script');
  calendlyScript.src = 'https://assets.calendly.com/assets/external/widget.js';
  calendlyScript.async = true;
  document.head.appendChild(calendlyScript);

  // Contact form
  const contactForm = document.getElementById('contact-form-el') as HTMLFormElement | null;
  const contactStatus = document.getElementById('contact-form-status');

  if (contactForm && contactStatus) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      contactStatus.textContent = '';
      contactStatus.className = 'form-status';

      const formData = new FormData(contactForm);
      const payload = {
        type: 'contact',
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        message: formData.get('message'),
      };

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          contactStatus.textContent = 'Thank you! I\'ll be in touch within one business day.';
          contactStatus.classList.add('form-status--success');
          contactForm.reset();
        } else {
          throw new Error('Request failed');
        }
      } catch {
        contactStatus.textContent = 'Something went wrong. Please try again or email me directly.';
        contactStatus.classList.add('form-status--error');
      }
    });
  }

  // Newsletter form
  const newsletterForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const newsletterStatus = document.getElementById('newsletter-form-status');

  if (newsletterForm && newsletterStatus) {
    newsletterForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      newsletterStatus.textContent = '';
      newsletterStatus.className = 'form-status';

      const formData = new FormData(newsletterForm);
      const payload = {
        type: 'newsletter',
        email: formData.get('email'),
      };

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          newsletterStatus.textContent = 'You\'re subscribed! Watch your inbox for the next report.';
          newsletterStatus.classList.add('form-status--success');
          newsletterForm.reset();
        } else {
          throw new Error('Request failed');
        }
      } catch {
        newsletterStatus.textContent = 'Something went wrong. Please try again.';
        newsletterStatus.classList.add('form-status--error');
      }
    });
  }
</script>

<style>
  /* Content width */
  .content-narrow {
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* Page Hero */
  .page-hero {
    padding: var(--space-2xl) 0 var(--space-xl);
    text-align: center;
  }

  .page-hero__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-md);
  }

  .page-hero__subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 36rem;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Section Heading */
  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-lg);
  }

  /* Calendly Section */
  .calendly-section {
    padding: 0 0 var(--space-2xl);
  }

  .calendly-section__subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .calendly-container {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    max-width: 40rem;
  }

  .calendly-fallback {
    padding: var(--space-lg);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  /* Contact Form */
  .contact-form-section {
    padding: var(--space-2xl) 0;
    background: #f5f5f4;
  }

  .lead-form {
    max-width: 32rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-md);
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .label-optional {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .form-group input,
  .form-group textarea {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text);
    transition: border-color 0.15s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1);
  }

  .form-group textarea {
    resize: vertical;
  }

  .form-submit {
    border: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }

  .form-status {
    margin-top: var(--space-md);
    font-size: 0.875rem;
    min-height: 1.25rem;
  }

  .form-status--success {
    color: var(--color-accent);
  }

  .form-status--error {
    color: #b91c1c;
  }

  /* CTA Buttons */
  .cta {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .cta--primary {
    background: var(--color-accent);
    color: #ffffff;
  }

  .cta--primary:hover {
    background: var(--color-accent-hover);
    color: #ffffff;
  }

  /* Newsletter */
  .newsletter {
    padding: var(--space-2xl) 0;
    background: var(--color-accent);
    color: #ffffff;
    text-align: center;
  }

  .newsletter__heading {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--space-sm);
    color: #ffffff;
  }

  .newsletter__text {
    font-size: 0.9375rem;
    opacity: 0.9;
    margin-bottom: var(--space-lg);
    line-height: 1.7;
  }

  .newsletter__form {
    display: flex;
    gap: var(--space-sm);
    max-width: 28rem;
    margin: 0 auto;
  }

  .newsletter__input {
    flex: 1;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .newsletter__input::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .newsletter__input:focus {
    outline: none;
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.25);
  }

  .newsletter__btn {
    flex-shrink: 0;
    border: 1px solid #ffffff;
    background: #ffffff;
    color: var(--color-accent);
    cursor: pointer;
    font-family: var(--font-sans);
  }

  .newsletter__btn:hover {
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-accent);
  }

  .newsletter .form-status--success {
    color: #ffffff;
    opacity: 0.9;
  }

  .newsletter .form-status--error {
    color: #fecaca;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }

    .newsletter__form {
      flex-direction: column;
    }
  }
</style>
