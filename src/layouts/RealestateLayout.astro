---
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = '' } = Astro.props;
const canonicalUrl = `https://realestate.corywong.ca${canonicalPath}`;

const navItems = [
  { label: 'Buy', href: '/buy' },
  { label: 'Sell', href: '/sell' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Cory Wong" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cory Wong, Real Estate Agent" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <meta property="twitter:card" content="summary" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header site-header--realestate">
      <div class="container container--wide">
        <a href="/" class="site-header__name">Cory Wong</a>
        <button class="site-header__toggle" aria-label="Toggle menu" aria-expanded="false">
          <span class="site-header__hamburger"></span>
        </button>
        <nav class="site-header__nav" aria-label="Main navigation">
          {navItems.map(item => (
            <a href={item.href} class="site-header__link">{item.label}</a>
          ))}
          <a href="/contact" class="site-header__cta">Book a Consultation</a>
        </nav>
      </div>
    </header>

    <div class="brokerage-bar">
      <div class="container">
        Cory Wong, Real Estate Agent. Trustwell Realty Inc., Brokerage.
      </div>
    </div>

    <main>
      <slot />
    </main>

    <div class="compliance-disclosure">
      <div class="container">
        Cory Wong, Real Estate Agent. Real estate services provided through Trustwell Realty Inc., Brokerage. For consumer protection information, visit <a href="https://www.reco.on.ca" target="_blank" rel="noopener noreferrer">reco.on.ca</a>.
      </div>
    </div>

    <footer class="site-footer">
      <div class="container container--wide">
        <div class="site-footer__top">
          <div class="site-footer__brand">
            <p class="site-footer__disclosure">
              Cory Wong, Real Estate Agent. Real estate services provided through Trustwell Realty Inc., Brokerage.
            </p>
            <p class="site-footer__reco">
              For consumer protection information, visit <a href="https://www.reco.on.ca" target="_blank" rel="noopener noreferrer">reco.on.ca</a>.
            </p>
          </div>
          <nav class="site-footer__nav" aria-label="Footer navigation">
            <a href="/buy">Buy</a>
            <a href="/sell">Sell</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="/market-updates">Market Updates</a>
            <a href="/neighbourhoods">Neighbourhoods</a>
            <a href="/resources">Resources</a>
          </nav>
        </div>
        <div class="site-footer__bottom">
          <nav class="site-footer__legal" aria-label="Legal links">
            <span>Privacy Policy</span>
            <span>Terms of Use</span>
            <span>Accessibility</span>
          </nav>
          <p class="site-footer__copyright">
            &copy; {new Date().getFullYear()} Trustwell Realty Inc., Brokerage. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.site-header__toggle');
      const nav = document.querySelector('.site-header__nav');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const expanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!expanded));
          nav.classList.toggle('site-header__nav--open');
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #fafaf9;
    --color-surface: #ffffff;
    --color-text: #1c1917;
    --color-text-muted: #57534e;
    --color-accent: #0f766e;
    --color-accent-hover: #0d9488;
    --color-border: #e7e5e4;
    --color-footer-bg: #1c1917;
    --color-footer-text: #d6d3d1;
    --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 2rem;
    --space-xl: 3rem;
    --space-2xl: 5rem;
    --max-width: 720px;
    --max-width-wide: 960px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { font-size: 100%; -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { font-family: var(--font-sans); color: var(--color-text); background: var(--color-bg); line-height: 1.7; min-height: 100vh; display: flex; flex-direction: column; }
  main { flex: 1; }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--color-accent); text-decoration: none; transition: color 0.15s ease; }
  a:hover { color: var(--color-accent-hover); }
  .container { width: 100%; max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-lg); }
  .container--wide { max-width: var(--max-width-wide); }
</style>

<style>
  .site-header {
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .site-header .container { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-sm); }
  .site-header__name { font-size: 1.125rem; font-weight: 600; color: var(--color-text); text-decoration: none; letter-spacing: -0.01em; }
  .site-header__name:hover { color: var(--color-accent); }
  .site-header--realestate { border-bottom-color: var(--color-accent); border-bottom-width: 2px; }
  .site-header__nav { display: flex; align-items: center; gap: var(--space-md); }
  .site-header__link { font-size: 0.9375rem; font-weight: 500; color: var(--color-text-muted); text-decoration: none; transition: color 0.15s ease; }
  .site-header__link:hover { color: var(--color-accent); }
  .site-header__cta { display: inline-block; padding: 0.5rem 1.25rem; border-radius: 6px; font-weight: 600; font-size: 0.875rem; text-decoration: none; background: var(--color-accent); color: #ffffff; transition: background-color 0.15s ease; white-space: nowrap; }
  .site-header__cta:hover { background: var(--color-accent-hover); color: #ffffff; }
  .site-header__toggle { display: none; background: none; border: none; cursor: pointer; padding: var(--space-xs); }
  .site-header__hamburger, .site-header__hamburger::before, .site-header__hamburger::after { display: block; width: 24px; height: 2px; background: var(--color-text); border-radius: 1px; transition: transform 0.2s ease; }
  .site-header__hamburger { position: relative; }
  .site-header__hamburger::before, .site-header__hamburger::after { content: ''; position: absolute; left: 0; }
  .site-header__hamburger::before { top: -7px; }
  .site-header__hamburger::after { top: 7px; }

  @media (max-width: 768px) {
    .site-header__toggle { display: block; }
    .site-header__nav { display: none; width: 100%; flex-direction: column; align-items: stretch; gap: 0; padding-top: var(--space-md); border-top: 1px solid var(--color-border); }
    .site-header__nav--open { display: flex; }
    .site-header__link { padding: var(--space-sm) 0; border-bottom: 1px solid var(--color-border); }
    .site-header__cta { margin-top: var(--space-sm); text-align: center; }
  }

  .brokerage-bar { background: var(--color-accent); color: #ffffff; padding: var(--space-xs) 0; font-size: 0.8125rem; font-weight: 500; text-align: center; letter-spacing: 0.01em; }

  .compliance-disclosure { padding: var(--space-md) 0; background: #f5f5f4; font-size: 0.8125rem; color: var(--color-text-muted); text-align: center; border-top: 1px solid var(--color-border); }
  .compliance-disclosure a { font-weight: 500; }

  .site-footer { background: var(--color-footer-bg); color: var(--color-footer-text); padding: var(--space-xl) 0 var(--space-lg); margin-top: auto; font-size: 0.875rem; line-height: 1.6; }
  .site-footer__top { display: flex; justify-content: space-between; gap: var(--space-xl); padding-bottom: var(--space-lg); border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
  .site-footer__brand { max-width: 28rem; }
  .site-footer__disclosure { font-weight: 500; margin-bottom: var(--space-xs); }
  .site-footer__reco { font-size: 0.8125rem; opacity: 0.85; }
  .site-footer__reco a { color: var(--color-accent-hover); }
  .site-footer__nav { display: flex; flex-direction: column; gap: var(--space-xs); font-size: 0.8125rem; }
  .site-footer__nav a { color: var(--color-footer-text); opacity: 0.8; }
  .site-footer__nav a:hover { color: var(--color-accent-hover); opacity: 1; }
  .site-footer__bottom { padding-top: var(--space-md); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-sm); }
  .site-footer__legal { display: flex; gap: var(--space-md); font-size: 0.75rem; opacity: 0.5; }
  .site-footer__copyright { opacity: 0.4; font-size: 0.75rem; }

  @media (max-width: 640px) {
    .site-footer__top { flex-direction: column; gap: var(--space-lg); }
    .site-footer__bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
